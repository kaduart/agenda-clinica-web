# 🌍 Agenda Clínica Web - Configuração de Ambiente

# URL da API do CRM Backend
# Local: http://localhost:5000
# Produção: https://fono-inova-crm-back.onrender.com
VITE_API_URL=https://fono-inova-crm-back.onrender.com

# Token de autenticação para integração com CRM
# Deve ser o mesmo valor de AGENDA_EXPORT_TOKEN no backend
VITE_API_TOKEN=<seu-token-aqui>

# Ambiente (development, production)
VITE_NODE_ENV=development
